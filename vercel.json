{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "caterus.vercel.app"
        }
      ],
      "destination": "https://caterus.honeyanddough.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "caterus.vercel.app"
        }
      ],
      "destination": "https://caterus.honeyanddough.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
